% erie theme
% https://github.com/cgcostanzo/erie

% ====================
% Definitions
% ====================

\definecolor{erieblue}{RGB}{5, 79, 80}
\definecolor{eriesky}{RGB}{204, 229, 230}

% ====================
% Theme
% ====================

% Basic colors: black text on white, erieblue as the single accent
\setbeamercolor{normal text}{fg=black,bg=white}
\setbeamercolor{palette primary}{fg=black,bg=white}
\setbeamercolor{palette secondary}{fg=black,bg=white}
\setbeamercolor{palette tertiary}{bg=black,fg=white}
\setbeamercolor{palette quaternary}{fg=black,bg=white}
\setbeamercolor{structure}{fg=erieblue}

% Accent lines (used by the frametitle and title page templates)
\setbeamercolor{accent line}{fg=erieblue}

% Itemize
\setbeamercolor{item}{fg=erieblue}

% Page numbering
\setbeamercolor{page number in head/foot}{fg=structure.fg}

% Frame titles: black text, accent comes from the rule beneath
\setbeamercolor{frametitle}{fg=black}
\setbeamercolor{title page}{fg=black}

% Emphasis
\setbeamercolor{alerted text}{fg=erieblue}

% Blocks (rarely used, kept consistent with the accent)
\setbeamercolor{block title}{fg=white,bg=erieblue}
\setbeamercolor{block body}{bg=eriesky}

% Section pages
\setbeamercolor{section title}{fg=black}
